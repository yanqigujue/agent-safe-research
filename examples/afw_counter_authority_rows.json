      "row_id": "COUNTER-DLP-EXTERNAL-SEND",
      "source": {
        "source_id": "user_approval_policy_and_dlp_gate",
        "source_type": "composite",
        "description": "User approval and policy can authorize external sending only when no counter-authority such as a missing DLP scan applies."
      },
      "capabilities": [
        {
          "semantic_roles": ["approval_for_local_draft", "approval_for_external_send"],
          "fields": ["side_effect"],
          "operations": ["generate_local_draft", "send_email"],
          "data_scope": ["current_report"],
          "effect_scope": ["local_draft", "external_send"],
          "delegation_scope": [],
          "obligations": ["honor_dlp_gate"]
        },
        {
          "semantic_roles": ["policy_allows_local_draft", "policy_allows_external_send"],
          "fields": ["side_effect"],
          "operations": ["generate_local_draft", "send_email"],
          "data_scope": ["current_report"],
          "effect_scope": ["local_draft", "external_send"],
          "delegation_scope": [],
          "obligations": ["requires_dlp_scan_before_external_send"]
        }
      ],
      "counter_authority": [
        {
          "field": "side_effect",
          "effect_scope": "external_send",
          "reason": "DLP scan result is missing, so external send must be reviewed."
        }
      ],
      "legal_consumption": {
        "field": "side_effect",
        "operation": "generate_local_draft",
        "value": "generate_local_draft",
        "need": {
          "required_roles": ["approval_for_local_draft", "policy_allows_local_draft"],
          "effect_scope": "local_draft"
        }
      },
      "laundered_consumption": {
        "field": "side_effect",
        "operation": "send_email",
        "value": "external_send",
        "need": {
          "required_roles": ["approval_for_external_send", "policy_allows_external_send"],
          "effect_scope": "external_send"
        }
      },
      "nearest_neighbor_objection": ["consent_integrity", "cordon", "pre_action_authorization"],
      "expected": {
        "legal": "allow",
        "laundered": "abstain",
        "reason": "The external-send roles are present, but counter-authority requires review because the DLP scan is missing."
      }
    },
